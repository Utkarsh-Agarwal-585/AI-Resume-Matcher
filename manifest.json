{
    "manifest_version": 3,
    "name": "AI Resume Matcher",
    "version": "1.0",
    "description": "Match Resume with Job Description using AI",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*"
    ],
    "icons": {
        "16":  "icons/icon16.png",
        "32":  "icons/icon32.png",
        "48":  "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16":  "icons/icon16.png",
            "32":  "icons/icon32.png",
            "48":  "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "web_accessible_resources": [
        {
            "resources": ["libs/pdf.worker.min.mjs"],
            "matches": ["<all_urls>"]
        }
    ]
}